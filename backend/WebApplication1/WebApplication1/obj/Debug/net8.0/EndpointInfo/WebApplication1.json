            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "isActive": {
            "type": "boolean"
          },
          "clienturi": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Demand": {
        "required": [
          "date",
          "ordonnance",
          "patID"
        ],
        "type": "object",
        "properties": {
